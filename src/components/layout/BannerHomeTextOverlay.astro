---
import { Icon } from "astro-icon/components";
import { backgroundWallpaper } from "@/config";
import { encodeMailto, MAILTO_ONCLICK_SCRIPT } from "@/utils/email-utils";

interface Props {
	showHomeText: boolean;
	initialRandomSubtitle: string | undefined;
}
const { showHomeText } = Astro.props;
const homeText = backgroundWallpaper.common?.homeText;
---
{homeText?.enable && (
	<div class:list={["banner-home-text-overlay alice-hero absolute inset-0 z-20 flex items-center", { hidden: !showHomeText }]}>
		<div class="alice-hero-copy">
			<p class="hero-eyebrow"><span aria-hidden="true">✧</span> ALICE’S MOONLIT JOURNAL</p>
			<div class="banner-title">{homeText.title}</div>
			<p class="hero-description">收藏学习的碎片，留住生活的回声。<br />在自己的小小宇宙里，慢慢生长。</p>
			<div class="hero-actions">
				<a class="hero-read" href="#journal-start">翻开手记 <span aria-hidden="true">↘</span></a>
				<button type="button" class="hero-replay" data-replay-opening><span aria-hidden="true">▷</span> 重播开场</button>
			</div>
			<div class="hero-bottom">
				<span class="hero-chapter">01 / THE MOONLIT CHAPTER</span>
				{homeText.linksEnable !== false && (
					<div class="banner-links">
						{homeText.links?.map((link) => {
							const email = link.url.startsWith("mailto:");
							const external = link.url.startsWith("http");
							return <a href={email ? "#" : link.url} class="banner-link" aria-label={link.name} title={link.name} data-encoded-email={email ? encodeMailto(link.url) : undefined} onclick={email ? MAILTO_ONCLICK_SCRIPT : undefined} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}><Icon name={link.icon} /></a>;
						})}
					</div>
				)}
			</div>
		</div>
	</div>
)}
